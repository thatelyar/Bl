{
  "name": "Kairo — Daily Planner",
  "short_name": "Kairo",
  "description": "A calm, minimal daily planner with goals, focus and reminders.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F3F0E8",
